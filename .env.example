# 로컬 개발용 예시입니다. 실제 값은 .env.local 에 넣으세요 (git에 커밋하지 않습니다).
# 배포 값은 Cloudflare Pages 환경변수에서 관리합니다.

# API 서버 주소 (예: https://devs.kangyu.shop). 비워두면 상대 경로로 요청합니다.
VITE_API_BASE_URL=

# Sentry DSN (에러 + 성능). 비워두면 초기화를 건너뜁니다.
VITE_SENTRY_DSN=

# Amplitude 프로젝트 API 키 (이벤트 + 세션 리플레이). 비워두면 초기화를 건너뜁니다.
# 프로덕션 빌드에서만 초기화합니다.
VITE_AMPLITUDE_API_KEY=

# Google Tag Manager 컨테이너 ID. 개발 빌드에서는 .env.development 가 비워 둡니다.
VITE_GTM_ID=

# 소스맵 업로드용. 빌드할 때만 쓰고 브라우저로는 나가지 않습니다.
# 토큰은 비밀값이라 커밋하지 않습니다.
SENTRY_AUTH_TOKEN=
SENTRY_PROJECT=
