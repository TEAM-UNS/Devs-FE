# Sentry DSN (에러 + Performance Monitoring). 비워두면 Sentry 초기화를 건너뜁니다.
# 실제 값은 .env.local 에 넣으세요 (git에 커밋하지 않음).
VITE_SENTRY_DSN=

# API 서버 주소 (예: https://api.example.com). 비워두면 상대 경로로 요청합니다.
VITE_API_BASE_URL=

# Amplitude 프로젝트 API 키 (이벤트 + 세션 리플레이). 비워두면 초기화를 건너뜁니다.
# 프로덕션 값은 .env.production 에 있습니다.
VITE_AMPLITUDE_API_KEY=

# Google Tag Manager 컨테이너 ID. 빌드 대상별 값은 .env.production / .env.development 에 있습니다.
VITE_GTM_ID=
